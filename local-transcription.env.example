# Perfil local evaluado con la grabación completa de Athenas.
# Exportar estas variables al iniciar el servicio; este archivo no se carga solo.
TRANSCRIPTION_ENGINE=faster-whisper
LOCAL_WHISPER_MODEL=large-v3-turbo
LOCAL_WHISPER_CHUNK_SECONDS=120
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_THREADS=4
LLM_STRUCTURE=0
# Preparar primero los pesos con: python local_transcription.py --download
# Mantener la misma LOCAL_WHISPER_CACHE durante preparación y ejecución.
# Configurar API_SECRET por separado; no hace falta OPENAI_API_KEY.
